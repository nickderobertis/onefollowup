  "targetDefaults": {
    "budgets": {
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "^production",
        {
          "dependentTasksOutputFiles": "**/telemetry/*.json"
        },
        {
          "externalDependencies": [
            "@onebudgetspec/cli"
          ]
        },
        {
          "runtime": "node -p process.platform"
        },
        "{workspaceRoot}/.github/ci-tool-versions",
        "{workspaceRoot}/rust-toolchain.toml"
      ]
    },
    "budgets-host": {
      "cache": false,
      "inputs": [
        "default",
        "^production",
        {
          "runtime": "node -p process.platform"
        },
        "{workspaceRoot}/.github/ci-tool-versions",
        "{workspaceRoot}/rust-toolchain.toml"
      ]
    },
    "test": {
      "cache": true,
      "inputs": [
        "testInputs",
        "^testInputs"
      ],
      "outputs": []
    },
    "build": {
      "inputs": [
        "default",
        "^production",
        {
          "runtime": "node -p process.platform"
        },
        "{workspaceRoot}/.github/ci-tool-versions",
        "{workspaceRoot}/rust-toolchain.toml"
      ]
    },
    "e2e": {
      "inputs": [
        "default",
        "^production",
        {
          "runtime": "node -p process.platform"
        },
        "{workspaceRoot}/.github/ci-tool-versions",
        "{workspaceRoot}/rust-toolchain.toml"
      ]
    },
    "test-compile": {
      "cache": false
    },
    "lint": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/.github/ci-tool-versions",
        "{workspaceRoot}/rust-toolchain.toml"
      ]
    },
    "typecheck": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/.github/ci-tool-versions",
        "{workspaceRoot}/rust-toolchain.toml"
      ]
    }
  },
  "plugins": [
    "./scripts/nx-remote-cache.mjs"
  ]
